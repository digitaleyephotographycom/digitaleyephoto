# ---- Backblaze B2 (S3-compatible API) ----
# Find these in the Backblaze web console:
# B2_KEY_ID / B2_APPLICATION_KEY -> "App Keys" (create a new application key scoped to your bucket)
# B2_ENDPOINT / B2_REGION        -> your bucket's "Endpoint" on the bucket details page
# Bucket must be set to PRIVATE. All photo access uses short-lived presigned URLs.
# B2_PUBLIC_BASE_URL is NOT required.
B2_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your_bucket_name
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# ---- App ----
# Any long random string. Used to sign short-lived client gallery sessions.
GALLERY_TOKEN_SECRET=change-this-to-a-long-random-string

# ---- Admin Authentication ----
# Admin login email/username
ADMIN_EMAIL=admin@example.com
# Admin password hashed with bcrypt (e.g. bcrypt.hashSync('your-password', 10))
ADMIN_PASSWORD_HASH=replace-with-bcrypt-password-hash
# Secret used to sign HttpOnly admin session tokens
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
